# Bangumi person ID to monitor (e.g., 12345)
TARGET_BANGUMI_ID=

# State backend: local | firestore
STATE_BACKEND=local

# Animator name for AniList search
TARGET_NAME=

# Local state directory (used when STATE_BACKEND=local)
DATA_DIR=data

# Notification backend: console | email
NOTIFIER=console
# Optional multi-target fanout (comma-separated): e.g. console,email
# When set, NOTIFIERS takes precedence over NOTIFIER.
NOTIFIERS=

# Notification retry (in-run retry with exponential backoff)
NOTIFY_RETRY_MAX_RETRIES=2
NOTIFY_RETRY_INITIAL_DELAY_SECONDS=60

# ---- Firestore state backend settings (required when STATE_BACKEND=firestore) ----
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=

# ---- Email notifier settings (required when NOTIFIER=email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
# Optional templates (variables: {title}, {message})
EMAIL_SUBJECT_TEMPLATE=[ACM] {title}
EMAIL_BODY_TEMPLATE={title}\n\n{message}
